# ── Voxmetriks .gitignore ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
!**/.env.example
!**/.env.e2e.example
!.env.demo.example
apps/frontend/.env
apps/frontend/.env.local

# Demo runtime / laptop bundles
runtime/
scripts/.demo-pids/
data/media/
apps/backend/data/media/
apps/backend/data/smoke-*
VOXMETRIKS-DEMO-RUNTIME/
VOXMETRIKS-CLEAN-TEST/
VOXMETRIKS-DEMO-BACKUP/

# DuckDB / SQLite (never commit local warehouses)
*.duckdb
*.duckdb.wal
*.duckdb.bak
*.bak_*.duckdb
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/

# Node / Angular
node_modules/
apps/frontend/dist/
apps/frontend/.angular/
**/.angular/
coverage/

# Generic build output
dist/
build/

# Data (local / generated)
data/processed/
data/warehouse/
apps/backend/data/
*.parquet
*.csv

# Test artifacts
.pytest_cache/
apps/backend/tests/.pytest_db/
apps/backend/tests/**/*.duckdb
.ruff_cache/
.coverage
htmlcov/
automation/playwright/e2e/.auth/
**/test-results/
**/playwright-report/
**/test-results-051/
**/playwright-report-051/
automation/playwright/test-results-051/
automation/playwright/playwright-report-051/
docs/uml/_rendered/
pytest-*.txt

# Agent / local temp capture
.tmp-*
.tmp_*

# Credentials / keys (never commit)
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# IDE
.vscode/
.idea/
*.swp
VOXMETRIKS.git/
.git-rewrite-clean.sh
.git-purge-bare-clone.sh

# Logs
*.log
logs/
apps/backend/logs/

# Review / agent temp artifacts
apps/backend/_*.txt
apps/frontend/_*.txt
apps/backend/tests/_*.json
apps/backend/tests/_*.txt
apps/sub-test-out.txt
**/sub-test-out.txt

# OS
Thumbs.db
Desktop.ini
.DS_Store
