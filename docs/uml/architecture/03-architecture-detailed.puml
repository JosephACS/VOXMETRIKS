@startuml voxmetriks-architecture-detailed

' Version detallada original (puede fallar en PlantUML web por card/storage/portin)

' Usar 03-architecture.puml para export PNG



skinparam nodesep 40

skinparam ranksep 50



title Voxmetriks — Arquitectura (detallado)



actor "Usuario\n(navegador)" as Browser

actor "Engineer" as Eng

actor "DevOps" as Ops



node "Cliente" {

  component "Angular SPA\nfrontend/\npuerto dev: 4200" as SPA

}



node "Docker Compose app — compose.yml" as Compose {



  node "Servicios persistentes" as Svc {

    component "backend\nuvicorn app.main:app\n:8000" as API

    component "frontend\nnginx + SPA\n:8080" as FEDocker

  }



  folder "Volúmenes app" as Vol {

    database "data/warehouse\nvoxmetrik.duckdb" as VDB

    component "data/bronze|silver|gold\nParquet" as VPQ

  }

}



node "Airflow Spec 048\ninfrastructure/airflow/compose.yml" as AF {



  component "LocalExecutor\nUI :8081" as AirflowUI

  database "Postgres metadata\n(orquestador)" as AFMeta

  component "DAG voxmetriks_elt\norchestrated_pipeline.py" as DAG

}



cloud "ELT canónico\n(host o subprocess Airflow)" as LocalELT {

  component "elt_pipeline.py\ntransforms autoritativos" as Pipeline

  component "validate_warehouse.py\nanalyze_warehouse.py" as Scripts

}



cloud "Fuente opcional" as Src {

  component "PocketBase\n(ingest)" as PB

}



Browser --> SPA : UI / routing\nauthGuard | engineerGuard

Eng --> SPA : /elt-pipeline\n/explorer

SPA --> API : REST /api/v1/*\nBearer session token

SPA --> API : GET /health\n(vía StatsService)

FEDocker ..> SPA : sirve build



Ops --> Pipeline : make pipeline / CLI

Ops --> DAG : make airflow-trigger\n(mantenimiento DuckDB)

Ops --> Scripts : post-ELT manual



AirflowUI --> DAG

DAG --> Pipeline : subprocess etapas

AFMeta ..> AirflowUI : metadata only



Pipeline --> PB : extract CSV\n(opcional)

Pipeline --> VPQ : Bronze / Silver / Gold Parquet

Pipeline --> VDB : Gold dims/facts/agg\nctl_carga_dataset\nctl_pipeline_stages

API --> VDB : read + write\n(app_user, app_playlist,\ncatalog CRUD, synthetic)



note bottom of AF
  Separado del compose.yml de aplicación.
  No producción / HA. schedule=None.
  No escribir DuckDB a la vez que backend.
end note



package "Capas Medallion (DuckDB)" as Layers #FFF8DC {

  component "Bronze\nraw_spotify Parquet" as B

  component "Silver\nParquet limpio" as S

  component "Gold\ndim_* fact_* agg_* ctl_*" as G

  component "App\napp_user app_playlist app_favorite" as A

  B -down-> S : transform

  S -down-> G : load + build

  G -down-> A : API runtime

}



VDB ..> Layers



note right of API

  Contratos publicos

  GET /  — metadata API

  GET /health — HealthResponse

  GET /docs — OpenAPI

end note



note left of SPA

  Paquetes FE (P2)

  PKG-01 users · PKG-02 streaming

  PKG-03 player · PKG-04 discovery

  PKG-05 settings · PKG-06 analytics

  PKG-07 data-engineering

end note



@enduml

