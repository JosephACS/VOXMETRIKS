@startuml voxmetriks-seq-recommendations
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 10
title Secuencia — Recomendación musical explicable

actor Oyente as U
participant "Angular" as FE
participant "Analytics API" as API
participant "Ranking heurístico" as Rank
database "agg_recommendation_scores" as Scores
database "dim_track + fuentes reproducibles" as Catalog

U -> FE : abrir recomendaciones
FE -> API : GET /analytics/recommendations
API -> Rank : solicitar ranking
Rank -> Scores : scores globales precomputados
Rank -> Catalog : metadatos y disponibilidad
Rank --> API : ranking + razones
API --> FE : recomendaciones reproducibles
FE --> U : tarjetas y explicación

note over Rank
  Reglas, pesos, coescucha y similitud.
  No se afirma ML entrenado.
end note
@enduml
