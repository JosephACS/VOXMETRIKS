@startuml voxmetriks-components-backend-datos
skinparam componentStyle rectangle
skinparam defaultFontSize 11
top to bottom direction

title VOXMETRIKS — Componentes backend y datos

package "FastAPI" as API #E8F8E8 {
  component "Identity + Organizations\nsesiones · membresías · RBAC" as Identity
  component "Music + Catalog\nbúsqueda · audio · artistas · derechos" as Music
  component "Enterprise Operations\nCRM · subscriptions · billing · campaigns" as Enterprise
  component "Analytics + Reporting\nKPI · reports · decisions · Workpanel" as Analytics
  component "Platform Ops\nhealth · jobs · audit" as Ops
}

package "Datos de negocio — DuckDB" as BusinessData #FFF8E7 {
  database "Estado operacional\napp_*" as AppDB
  database "Warehouse Gold\ndim_* · fact_* · agg_* · ctl_*" as Warehouse
  folder "Medallion\nBronze · Silver · Gold Parquet" as Parquet
}

package "Orquestación ELT — Spec 048" as Orchestration #E8F0FF {
  component "DAG voxmetriks_elt\n8 tareas · schedule manual" as DAG
  component "ELT canónico\nelt_pipeline.py" as ELT
  database "PostgreSQL\nmetadata Airflow" as AirflowMeta
}

cloud "PocketBase / Parquet cache\nfuente catálogo" as Source

Identity --> AppDB
Music --> AppDB
Music --> Warehouse
Enterprise --> AppDB
Analytics --> AppDB
Analytics --> Warehouse
Ops --> AppDB
Ops --> Warehouse

Source --> ELT : extract
DAG --> ELT : coordina etapas
DAG --> AirflowMeta : estado/logs
ELT --> Parquet
ELT --> Warehouse

note right of AppDB
  Alcance académico: estado operacional y
  warehouse comparten el mismo archivo DuckDB.
  No se afirma OLTP productivo independiente.
end note

note right of DAG
  Single-writer: detener la aplicación
  durante el rebuild Airflow.
end note
@enduml
