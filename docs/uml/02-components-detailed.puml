@startuml voxmetriks-components-detailed
' Version detallada (puede recortarse al exportar PNG) — ver 02-components.puml compacta
' Diagrama de componentes — PKG-01..07 + capas transversales
' Fuente: specs 001–011, backend/app/packages/, frontend/src/app/packages/

skinparam componentStyle rectangle
skinparam linetype ortho

title Voxmetriks — Componentes por dominio (detallado)

package "Frontend — Angular 19" as FE {

  package "Core (transversal)" as FECore {
    [AuthService\nauth.guard\nengineer.guard] as Auth
    [ApiInterceptor] as Interceptor
    [UiPreferencesService] as UiPrefs
    [I18nService] as I18n
    [MusicPlayerService] as Player
    [DashboardLayout] as Layout
  }

  package "PKG-01 users" as FEP01 {
    [LoginComponent] as Login
    [UsersComponent] as UsersUI
  }

  package "PKG-02 streaming" as FEP02 {
    [Home / Artists / Tracks\nSearch / Genres / AudioFeatures] as CatalogUI
    [PlaylistsComponent] as PlaylistsUI
    [LikedComponent] as LikedUI
    [FavoriteBtn / AddToPlaylistBtn] as LibWidgets
  }

  package "PKG-03 listening" as FEP03 {
    [PlayerBar / NowPlayingView] as PlayerUI
  }

  package "PKG-04 discovery" as FEP04 {
    [RecommendationsComponent] as RecUI
    [HistoryComponent] as HistUI
  }

  package "PKG-05 administration" as FEP05 {
    [SettingsComponent\n(tabs: api, warehouse*, pipeline*)] as SettingsUI
  }

  package "PKG-06 analytics" as FEP06 {
    [Dashboard / Trending\nAnalytics / Comparatives] as AnalyticsUI
    [StatsService] as StatsSvc
  }

  package "PKG-07 data-engineering" as FEP07 {
    [EltPipelineComponent] as EltUI
    [ExplorerComponent] as ExplorerUI
  }
}

package "Backend — FastAPI" as BE {

  package "app.main" as Main {
    [GET /  GET /health] as RootHealth
  }

  package "PKG-01 users" as BEP01 {
    [users.routes\nlogin | register | me] as UsersAPI
    [user_service\nuser_storage\nauth_deps] as UsersSvc
  }

  package "PKG-02 streaming" as BEP02 {
    [artists | genres | tracks\nplaylists | favorites] as StreamAPI
    [playlist_service\nfavorite_service\n*_service] as StreamSvc
  }

  package "PKG-06/07 analytics" as BEP67 {
    [stats.routes\nsummary | loads | synthetic] as StatsAPI
    [analytics.routes\nwarehouse | explorer | trending\nrecommendations | history] as AnalyticsAPI
    [stats_service\nanalytics_service] as AnalyticsSvc
  }
}

package "Datos y operaciones" as Data {

  database "DuckDB\nvoxmetrik.duckdb\n(Medallion Gold + app_*)" as DuckDB

  component "ELT CLI\nelt/pipelines/elt_pipeline.py" as ELTCLI

  component "Scripts ops\nvalidate_warehouse.py\nanalyze_warehouse.py" as Scripts

  cloud "PocketBase\n(opcional ingest)" as PB
}

Login --> UsersAPI : POST /api/v1/users/*
UsersUI --> UsersAPI
CatalogUI --> StreamAPI : GET /api/v1/*
PlaylistsUI --> StreamAPI : /playlists
LikedUI --> StreamAPI : /favorites
LibWidgets --> StreamAPI
RecUI --> AnalyticsAPI : /recommendations
HistUI --> AnalyticsAPI : /history
AnalyticsUI --> StatsAPI
AnalyticsUI --> AnalyticsAPI
EltUI --> StatsAPI : limits, loads, synthetic
EltUI --> AnalyticsAPI : warehouse
ExplorerUI --> AnalyticsAPI : explorer/*
ExplorerUI --> StatsAPI : loads
SettingsUI --> RootHealth : GET /health
Auth ..> Interceptor : Bearer token

UsersAPI --> DuckDB
StreamAPI --> DuckDB
StatsAPI --> DuckDB
AnalyticsAPI --> DuckDB
RootHealth --> DuckDB

PB ..> ELTCLI : extract (opcional)
ELTCLI --> DuckDB : Bronze→Silver→Gold
Scripts ..> DuckDB : validación CLI
StatsAPI ..> DuckDB : POST synthetic\n(ctl_carga_dataset)

note bottom of EltUI
  * tabs warehouse/pipeline
  solo engineer (006 FR-ST11, 008)
end note

note bottom of ELTCLI
  Docker Compose service `pipeline`
  job one-shot antes de `api` (P7)
end note

@enduml
