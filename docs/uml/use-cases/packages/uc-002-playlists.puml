@startuml uc-002-playlists
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 002 — Playlists (PKG-02 | OT-02)

actor "Usuario Registrado" as User
actor "Sistema Voxmetriks" as Sys

rectangle "Biblioteca — Playlists" {
  usecase "CU-P01\nListar playlists" as CU_P01
  usecase "CU-P02\nCrear playlist" as CU_P02
  usecase "CU-P03\nVer detalle" as CU_P03
  usecase "CU-P04\nEditar playlist" as CU_P04
  usecase "CU-P05\nEliminar playlist" as CU_P05
  usecase "CU-P06\nAñadir track" as CU_P06
  usecase "CU-P07\nQuitar track" as CU_P07
}
User --> CU_P01
User --> CU_P02
User --> CU_P03
User --> CU_P04
User --> CU_P05
User --> CU_P06
User --> CU_P07
Sys --> CU_P03 : ownership
CU_P02 ..> CU_P01 : <<extend>>
CU_P06 ..> CU_P03 : <<extend>>

@enduml
