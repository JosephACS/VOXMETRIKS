@startuml uc-003-catalogo
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 003 — Catálogo (PKG-02 | OT-03)

actor "Usuario Registrado" as User
actor "Sistema Voxmetriks" as Sys

rectangle "Catálogo musical" {
  usecase "CU-C01\nListar artistas" as CU_C01
  usecase "CU-C02\nTop artistas" as CU_C02
  usecase "CU-C03\nListar géneros" as CU_C03
  usecase "CU-C04\nListar tracks" as CU_C04
  usecase "CU-C05\nDetalle track" as CU_C05
  usecase "CU-C06\nStats artista" as CU_C06
}
User --> CU_C01
User --> CU_C03
User --> CU_C04
User --> CU_C05
Sys --> CU_C01
CU_C05 ..> CU_C04 : <<extend>>

@enduml
