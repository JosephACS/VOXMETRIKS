@startuml uc-005-historial
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 005 — Historial (PKG-04 | OT-05)

actor "Usuario Registrado" as User
actor "Sistema Voxmetriks" as Sys

rectangle "Historial unificado" {
  usecase "CU-HI01\nHistorial escucha" as CU_HI01
  usecase "CU-HI02\nTimeline usuario" as CU_HI02
  usecase "CU-HI03\nHistorial búsquedas" as CU_HI03
  usecase "CU-HI04\nCambiar tabs" as CU_HI04
  usecase "CU-HI05\nLimpiar local" as CU_HI05
}
User --> CU_HI01
User --> CU_HI04
Sys --> CU_HI02
Sys --> CU_HI03
User --> CU_HI05

@enduml
