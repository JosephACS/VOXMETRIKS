@startuml uc-003-busqueda
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 003 — Búsqueda (PKG-02 | OT-03)

actor "Usuario Registrado" as User
actor "Sistema Voxmetriks" as Sys

rectangle "Búsqueda" {
  usecase "CU-S01\nBuscar por texto" as CU_S01
  usecase "CU-S02\nVer resultados" as CU_S02
  usecase "CU-S03\nRegistrar en historial" as CU_S03
}
User --> CU_S01
User --> CU_S02
Sys --> CU_S03
CU_S01 ..> CU_S02 : <<include>>
CU_S02 ..> CU_S03 : <<include>>

@enduml
