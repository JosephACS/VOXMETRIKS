@startuml uc-005-recomendaciones
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 005 — Recomendaciones (PKG-04 | OT-05)

actor "Usuario Registrado" as User

rectangle "Descubrimiento personalizado" {
  usecase "CU-RC01\nVer listas" as CU_RC01
  usecase "CU-RC02\nUser-aware" as CU_RC02
  usecase "CU-RC03\nReproducir recomendado" as CU_RC03
  usecase "CU-RC04\nFavoritar desde lista" as CU_RC04
}
User --> CU_RC01
User --> CU_RC03
User --> CU_RC04
CU_RC01 ..> CU_RC02 : <<include>>
CU_RC03 ..> CU_R01 : <<include>> spec 004

@enduml
