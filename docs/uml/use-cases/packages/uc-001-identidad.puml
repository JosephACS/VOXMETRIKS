@startuml uc-001-identidad
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 001 — Identidad y acceso (PKG-01 | OT-01)

actor "Usuario Visitante" as Visitor
actor "Usuario Registrado" as User
actor "Sistema Voxmetriks" as Sys

rectangle "Identidad y acceso" {
  usecase "CU-01\nRegistrar cuenta" as CU_01
  usecase "CU-02\nIniciar sesión" as CU_02
  usecase "CU-03\nConsultar perfil" as CU_03
  usecase "CU-04\nActualizar preferencias" as CU_04
  usecase "CU-05\nCerrar sesión" as CU_05
  usecase "CU-06\nControl acceso rutas" as CU_06
  usecase "CU-07\nPersistir identidad" as CU_07
}
Visitor --> CU_01
Visitor --> CU_02
User --> CU_02
User --> CU_03
User --> CU_04
User --> CU_05
Sys --> CU_06
Sys --> CU_07
CU_01 ..> CU_02 : <<extend>> auto-login
CU_02 ..> CU_07 : <<include>>
CU_01 ..> CU_07 : <<include>>

@enduml
