@startuml uc-003-audio-features
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 003 — Audio features (PKG-02 | OT-03)

actor "Usuario Registrado" as User
actor "Sistema Voxmetriks" as Sys

rectangle "Características de audio" {
  usecase "CU-AF01\nExplorar distribución" as CU_AF01
  usecase "CU-AF02\nFeatures por track" as CU_AF02
}
User --> CU_AF01
User --> CU_AF02
Sys --> CU_AF01
note right of CU_AF02
  También accesible desde
  detalle track (CU-C05)
end note

@enduml
