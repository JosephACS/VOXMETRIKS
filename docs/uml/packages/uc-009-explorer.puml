@startuml uc-009-explorer
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 009 — Data Explorer (PKG-07 | OT-09)

actor "Usuario Ingeniero" as Eng

rectangle "Explorador warehouse" {
  usecase "CU-DE01\nListar tablas" as CU_DE01
  usecase "CU-DE02\nFiltrar tablas" as CU_DE02
  usecase "CU-DE03\nPreview filas" as CU_DE03
  usecase "CU-DE04\nPaginar preview" as CU_DE04
  usecase "CU-DE05\nClasificación y conteos" as CU_DE05
  usecase "CU-DE06\nHistorial cargas" as CU_DE06
  usecase "CU-DE07\nAcceso engineer" as CU_DE07
}
Eng --> CU_DE01
Eng --> CU_DE03
Eng --> CU_DE05
Eng --> CU_DE06
Eng --> CU_DE07
CU_DE01 ..> CU_DE02 : <<extend>>
CU_DE03 ..> CU_DE04 : <<include>>

@enduml
