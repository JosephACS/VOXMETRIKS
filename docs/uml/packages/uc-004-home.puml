@startuml uc-004-home
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 004 — Home hub (PKG-03 | OT-04)

actor "Usuario Registrado" as User
actor "Sistema Voxmetriks" as Sys

rectangle "Home" {
  usecase "CU-H01\nSaludo personalizado" as CU_H01
  usecase "CU-H02\nKPIs catálogo" as CU_H02
  usecase "CU-H03\nShortcuts navegación" as CU_H03
  usecase "CU-H04\nContinuar escuchando" as CU_H04
}
User --> CU_H01
User --> CU_H03
Sys --> CU_H02
User --> CU_H04

@enduml
