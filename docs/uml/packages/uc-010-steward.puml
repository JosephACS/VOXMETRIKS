@startuml uc-010-steward
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 010 — Catalog Steward (PKG-02 | OT-09)

actor "Usuario Registrado" as User

rectangle "Steward catálogo" {
  usecase "CU-CS01\nCrear artista" as CU_CS01
  usecase "CU-CS02\nEditar artista" as CU_CS02
  usecase "CU-CS03\nEliminar artista" as CU_CS03
  usecase "CU-CS04\nCrear género" as CU_CS04
  usecase "CU-CS05\nEditar género" as CU_CS05
  usecase "CU-CS06\nEliminar género" as CU_CS06
  usecase "CU-CS07\nCrear track" as CU_CS07
  usecase "CU-CS08\nEditar track" as CU_CS08
  usecase "CU-CS09\nEliminar track" as CU_CS09
}
User --> CU_CS01
User --> CU_CS04
User --> CU_CS07

@enduml
