@startuml uc-004-reproductor
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam defaultFontSize 10
skinparam nodesep 20
skinparam ranksep 24
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
left to right direction
title 004 — Reproductor (PKG-03 | OT-04)

actor "Usuario Registrado" as User

rectangle "Experiencia de escucha" {
  usecase "CU-R01\nReproducir track" as CU_R01
  usecase "CU-R02\nPausar / reanudar" as CU_R02
  usecase "CU-R03\nAjustar volumen" as CU_R03
  usecase "CU-R04\nSeek progreso" as CU_R04
  usecase "CU-R05\nSiguiente / anterior" as CU_R05
  usecase "CU-R06\nShuffle / repeat" as CU_R06
  usecase "CU-R07\nPlay cola completa" as CU_R07
  usecase "CU-R08\nNow-playing expandido" as CU_R08
}
User --> CU_R01
User --> CU_R02
User --> CU_R03
User --> CU_R05
User --> CU_R07
User --> CU_R08
CU_R01 ..> CU_R02 : <<include>>

@enduml
