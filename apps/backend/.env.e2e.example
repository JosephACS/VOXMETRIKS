# E2E / Playwright only — copy to .env.e2e for local E2E runs.
# NEVER use in development, staging, or production .env files.
#
# Load explicitly when starting the backend for Playwright:
#   npm run e2e:backend   (root package.json sets these via cross-env)
# Or:
#   set -a && source backend/.env.e2e && set +a && uvicorn ...

E2E=1
GLOBAL_RATE_LIMIT=0
AUTH_RATE_LIMIT=0
