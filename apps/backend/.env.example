# ============================================================
# VOXMETRIK_V2 — .env.example
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Leave blank to use default: <project_root>/data/warehouse/voxmetrik.duckdb
# Use an absolute path in Docker: /app/data/warehouse/voxmetrik.duckdb
DB_PATH=

# ── Runtime environment ───────────────────────────────────────
# "development" (default) or "production".
# production disables demo users, hides dev verification codes,
# turns off /docs, /redoc, /openapi.json and rejects wildcard CORS.
ENVIRONMENT=development

# ── FastAPI server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
HEALTH_VERBOSE=false
SEED_DEMO_USERS=true
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SEC=60
GLOBAL_RATE_LIMIT=120
GLOBAL_RATE_WINDOW_SEC=60

# E2E / Playwright ONLY — see backend/.env.e2e.example (do NOT copy into .env)

# ── Cache (in-process TTL, seconds) ───────────────────────────
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=60
CACHE_TTL_DASHBOARD=120
CACHE_TTL_ANALYTICS=90
CACHE_TTL_TOP_TRACKS=180
CACHE_TTL_RECOMMENDATIONS=120
CACHE_TTL_SMART_HOME=90
CACHE_TTL_AUDIO=300

# ── Platform jobs (Phase 5) ───────────────────────────────────
JOBS_ENABLED=true
JOBS_INTERVAL_SEC=300
SSE_ENABLED=true

# ── AI Provider (Phase 6) — local by default ─────────────────
# AI_PROVIDER=local | external | mock
AI_PROVIDER=local
# Optional — only if AI_PROVIDER=external (OpenAI-compatible API)
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_MODEL=gpt-4o-mini

# ── Logging ───────────────────────────────────────────────────
LOG_JSON=false
LOG_TO_FILES=true
LOG_DIR=logs
LOG_FILE_API=api.log
LOG_FILE_ERRORS=errors.log
LOG_FILE_DATABASE=database.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ── Pagination ────────────────────────────────────────────────
PAGINATION_DEFAULT_PAGE_SIZE=25
PAGINATION_MAX_PAGE_SIZE=200

# ── PocketBase ────────────────────────────────────────────────
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=your_admin@email.com
POCKETBASE_PASSWORD=your_password_here

# ── Audio playback (YouTube) ─────────────────────────────────
# YouTube Data API v3 key — enables real full-length playback through the
# official IFrame player. Create one (free) at https://console.cloud.google.com
# (APIs & Services → Credentials → API key, enable "YouTube Data API v3").
# Leave blank to keep the local demo tones.
YOUTUBE_API_KEY=

# ── Google Sign-In ───────────────────────────────────────────
# OAuth 2.0 Client ID ("Web application") from Google Cloud Console →
# APIs & Services → Credentials. Add http://localhost:4200 (and your prod
# domain) as Authorized JavaScript origins. Blank → Google button hidden.
GOOGLE_CLIENT_ID=

# ── Email (SMTP) for sign-up verification codes ──────────────
# Sends a 6-digit code on registration. Use an app password.
# Blank SMTP_HOST/SMTP_USER → DEV MODE (code logged + returned by the API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_PUBLIC_NAME=VOXMETRIK
EMAIL_CODE_TTL_MIN=15
EMAIL_CODE_MAX_ATTEMPTS=5
