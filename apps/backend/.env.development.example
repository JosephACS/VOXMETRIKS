# DEV-only example — placeholders only. Never commit real secrets.
# Usage (from apps/backend):
#   copy .env.development.example .env   (or merge into your local .env)
#   set VOXMETRIKS_SEED_DEMO_ACCOUNTS=1   # for scripts /admin/dev-seed
#   python scripts/seed_integrated_demo.py
#
# Do NOT use this file as a production template.

ENVIRONMENT=development
SEED_DEMO_USERS=true
SEED_DEMO_CRM_USERS=true

# Simulated checkout for local Spec 052 demos (FORBIDDEN in production).
PAYMENT_PROVIDER=academic_mock

DB_PATH=
# Optional shared password for DEV bootstrap accounts / integrated demo seed.
# Leave blank to use built-in local fallbacks only when SEED_DEMO_* is enabled.
DEMO_ACCOUNT_PASSWORD=
# Legacy aliases (optional if DEMO_ACCOUNT_PASSWORD is set):
# DEMO_PASSWORD=
# VOXMETRIKS_DEMO_PASSWORD=

VOXMETRIKS_SEED_DEMO_ACCOUNTS=1
EMAIL_PROVIDER=console
MEDIA_STORAGE_ROOT=data/media

# Optional presentation flags (DEV only)
SHOW_DEMO_ORGANIZATIONS=true
ALLOW_DEMO_SELF_APPROVE=true
