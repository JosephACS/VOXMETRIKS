# ── Contexto de build del backend/ELT — excluir lo que no necesita la imagen ──

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Entornos
.venv/
venv/
env/

# Frontend completo (tiene su propio Dockerfile y contexto)
frontend/

# PocketBase (se monta como volumen, no va en la imagen)
pocketbase/

# Datos (el pipeline los genera en runtime sobre el volumen)
data/
*.duckdb
*.duckdb.wal
*.parquet
*.csv
*.zip

# Specs / docs / entregas
specs/
docs/
.specify/
.kiro/
backend/tests/

# Git / IDE / tests
.git/
.gitignore
.pytest_cache/
.vscode/
.idea/

# Docs sueltos
*.md
README*

# OS
.DS_Store
Thumbs.db
