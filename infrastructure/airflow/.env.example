# Copy to .env (never commit secrets). Spec 048 academic/demo defaults.
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8081

# Airflow metadata Postgres (NOT VOXMETRIKS DuckDB)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=replace-me-airflow-meta
POSTGRES_DB=airflow

# Airflow UI bootstrap user (demo only)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace-me-airflow-ui

# Required by Airflow 3 API auth — generate a random string for local use
AIRFLOW__API_AUTH__JWT_SECRET=replace-me-jwt-secret-min-32-chars-xxxx

# Optional Fernet key (leave empty for local demo or generate with airflow)
AIRFLOW__CORE__FERNET_KEY=

# Host data directory mounted into the container as /opt/voxmetriks/data
# Default: repository data/ folder
VOXMETRIKS_DATA_DIR=../../data

# Optional PocketBase (only needed when Bronze cache is absent)
POCKETBASE_URL=
POCKETBASE_EMAIL=
POCKETBASE_PASSWORD=
