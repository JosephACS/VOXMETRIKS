# ============================================================
# VOXMETRIK_V2 — Root .env.example
# Copy this file to .env and fill in real values.
# Read by BOTH elt_pipeline.py and backend/config.py
# NEVER commit .env to git.
# ============================================================

# ── PocketBase ────────────────────────────────────────────────
POCKETBASE_URL=http://pocketbase:80
POCKETBASE_EMAIL=your_admin@example.com
POCKETBASE_PASSWORD=replace_with_a_strong_password

# ── Database (leave blank for auto-resolve) ───────────────────
# Default: <project_root>/data/warehouse/voxmetrik.duckdb
# Docker compose: /app/data/warehouse/voxmetrik.duckdb
DB_PATH=

# ── Runtime environment ───────────────────────────────────────
# "development" (default) or "production".
# production disables demo users, hides dev verification codes,
# turns off /docs, /redoc, /openapi.json and rejects wildcard CORS.
ENVIRONMENT=development

# ── Backend server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
HEALTH_VERBOSE=false
SEED_DEMO_USERS=true
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SEC=60

# ── Audio playback (YouTube) ─────────────────────────────────
# YouTube Data API v3 key — enables real full-length playback via the
# official IFrame player. Free key: https://console.cloud.google.com
# Leave blank to keep the local demo tones.
YOUTUBE_API_KEY=

# ── Google Sign-In ───────────────────────────────────────────
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Add http://localhost:4200 (and your prod domain) as Authorized JavaScript
# origins. Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=

# ── Email (SMTP) for sign-up verification codes ──────────────
# Used to email a 6-digit code on registration. Use an app password
# (Gmail: https://myaccount.google.com/apppasswords).
# If SMTP_HOST/SMTP_USER are blank, registration runs in DEV MODE:
# the code is logged and returned in the API response (localhost testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_PUBLIC_NAME=VOXMETRIK
EMAIL_CODE_TTL_MIN=15
EMAIL_CODE_MAX_ATTEMPTS=5

# ── Pipeline settings ─────────────────────────────────────────
PB_COLLECTION=datasets
MAX_RETRIES=3
RETRY_DELAY_S=2
