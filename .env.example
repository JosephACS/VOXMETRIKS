# VoxMetriks root env example — safe placeholders only (no real secrets).
# Copy to .env and fill locally. Prefer apps/backend/.env for API runtime.

DB_PATH=
ENVIRONMENT=development
MAX_APP_USERS=0
SEED_DEMO_USERS=false
SEED_DEMO_CRM_USERS=false
# Default ops recording. academic_mock is forbidden in production (tests/DEV only).
PAYMENT_PROVIDER=manual_transfer
# DEV-only optional password for bootstrap/demo seed scripts — leave blank otherwise.
# DEMO_ACCOUNT_PASSWORD=
EMAIL_PROVIDER=console
MEDIA_STORAGE_ROOT=data/media
