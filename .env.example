# ============================================================
# VOXMETRIK_V2 — Root .env.example
# Copy this file to .env and fill in real values.
# Read by BOTH elt_pipeline.py and backend/config.py
# NEVER commit .env to git.
# ============================================================

# ── PocketBase ────────────────────────────────────────────────
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=calderonsaltos1234@gmail.com
POCKETBASE_PASSWORD=20062023Saltos

# ── Database (leave blank for auto-resolve) ───────────────────
# Default resolves to <project_root>/duckdb/voxmetrik.duckdb
# In Docker use: /app/duckdb/voxmetrik.duckdb
DB_PATH=

# ── Backend server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO

# ── Pipeline settings ─────────────────────────────────────────
PB_COLLECTION=datasets
MAX_RETRIES=3
RETRY_DELAY_S=2
