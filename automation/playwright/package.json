{
  "name": "voxmetriks-e2e",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "e2e:backend": "cross-env GLOBAL_RATE_LIMIT=0 AUTH_RATE_LIMIT=0 E2E=1 npm --prefix ../../apps/backend exec -- uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "e2e:frontend": "npm start --prefix ../../apps/frontend -- --host 127.0.0.1 --port 4200",
    "e2e:051": "node e2e/harness/051-run.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "cross-env": "^7.0.3"
  }
}
