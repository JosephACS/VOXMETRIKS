# ============================================================
# VOXMETRIK_V2 — .env.example
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Leave blank to use default: <project_root>/data/warehouse/voxmetrik.duckdb
# Use an absolute path in Docker: /app/data/warehouse/voxmetrik.duckdb
DB_PATH=

# ── FastAPI server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
HEALTH_VERBOSE=false
SEED_DEMO_USERS=true
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SEC=60

# ── PocketBase ────────────────────────────────────────────────
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=your_admin@email.com
POCKETBASE_PASSWORD=your_password_here

# ── Audio playback (YouTube) ─────────────────────────────────
# YouTube Data API v3 key — enables real full-length playback through the
# official IFrame player. Create one (free) at https://console.cloud.google.com
# (APIs & Services → Credentials → API key, enable "YouTube Data API v3").
# Leave blank to keep the local demo tones.
YOUTUBE_API_KEY=

# ── Google Sign-In ───────────────────────────────────────────
# OAuth 2.0 Client ID ("Web application") from Google Cloud Console →
# APIs & Services → Credentials. Add http://localhost:4200 (and your prod
# domain) as Authorized JavaScript origins. Blank → Google button hidden.
GOOGLE_CLIENT_ID=

# ── Email (SMTP) for sign-up verification codes ──────────────
# Sends a 6-digit code on registration. Use an app password.
# Blank SMTP_HOST/SMTP_USER → DEV MODE (code logged + returned by the API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_PUBLIC_NAME=VOXMETRIK
EMAIL_CODE_TTL_MIN=15
EMAIL_CODE_MAX_ATTEMPTS=5
