# ============================================================
# VOXMETRIK_V2 — .env.example
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Leave blank to use default: ../duckdb/voxmetrik.duckdb
# Use an absolute path in Docker:  /app/duckdb/voxmetrik.duckdb
DB_PATH=

# ── FastAPI server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO

# ── PocketBase ────────────────────────────────────────────────
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_EMAIL=your_admin@email.com
POCKETBASE_PASSWORD=your_password_here
